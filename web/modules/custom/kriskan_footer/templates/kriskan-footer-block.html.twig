{#
/**
 * @file
 * Template for KRIS-KAN Footer block.
 */
#}
<div class="footer-custom container">
  <div class="row">
    <div class="col-md-3 mb-3 mb-md-0">
      <strong>Kontakt</strong>
      <span><i class="fa fa-phone"></i> {{ content.phone }}</span>
      <span><i class="fa fa-envelope"></i> {{ content.email }}</span>
    </div>
    <div class="col-md-3 mb-3 mb-md-0">
      <strong>Znajdź nas</strong>
      <a href="{{ content.facebook_url }}" class="text-white me-2" target="_blank">
        <i class="fab fa-facebook fa-lg"></i>
      </a>
      <a href="{{ content.instagram_url }}" class="text-white" target="_blank">
        <i class="fab fa-instagram fa-lg"></i>
      </a>
    </div>
    <div class="col-md-3">
      <strong>Linki</strong>
      <ul class="list-unstyled mb-0">
        {% for link in content.links %}
          <li><a href="{{ link.url }}" class="text-white" target="_blank">{{ link.label }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
</div> 